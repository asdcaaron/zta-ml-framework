{"version": "2.2.0", "type": "topology", "name": "ZTA Hybrid Workforce Topology", "project_id": "zta-ml-framework-gns3-week3", "auto_start": false, "topology": {"name": "ZTA Hybrid Workforce Topology", "type": "hybrid-zero-trust"}, "ip_plan": {"headquarters_office": "10.10.0.0/24 (gw 10.10.0.1)", "remote_branch": "10.20.0.0/24 (gw 10.20.0.1)", "cloud_dmz": "172.16.0.0/24 (gw 172.16.0.1)", "internet_attacker": "203.0.113.0/24 (attacker 203.0.113.10)", "zta_enforcement_point": "0.0.0.0:5000 (Flask API host, inline transparent)"}, "nodes": [{"id": 1, "label": "Core-Router", "type": "router", "x": 0, "y": -250, "properties": {"role": "internet_core", "image": "generic-router (user-supplied IOS/appliance)", "interfaces": {"Gi0/0": "10.10.0.1/24 (HQ)", "Gi0/1": "10.20.0.1/24 (Branch)", "Gi0/2": "172.16.0.1/24 (DMZ/Cloud)", "Gi0/3": "203.0.113.1/24 (Internet edge)"}}}, {"id": 2, "label": "SW-HQ", "type": "switch", "x": -300, "y": -100, "properties": {"segment": "headquarters_office", "subnet": "10.10.0.0/24", "image": "generic-switch"}}, {"id": 3, "label": "HQ-Workstation", "type": "VPCS", "x": -350, "y": 0, "properties": {"ip": "10.10.0.10/24", "gateway": "10.10.0.1", "role": "legitimate_hq_user", "traffic_origin": ["Normal"]}}, {"id": 4, "label": "SW-Branch", "type": "switch", "x": 300, "y": -100, "properties": {"segment": "remote_branch", "subnet": "10.20.0.0/24", "image": "generic-switch"}}, {"id": 5, "label": "Branch-Hybrid-Worker", "type": "VPCS", "x": 360, "y": 0, "properties": {"ip": "10.20.0.10/24", "gateway": "10.20.0.1", "role": "legitimate_remote_hybrid_worker", "traffic_origin": ["Normal"]}}, {"id": 6, "label": "Branch-Compromised-Host", "type": "VPCS", "x": 240, "y": 0, "properties": {"ip": "10.20.0.50/24", "gateway": "10.20.0.1", "role": "inside_attacker_compromised_branch_host", "traffic_origin": ["DoS", "Probe", "R2L", "U2R"]}}, {"id": 7, "label": "SW-DMZ", "type": "switch", "x": 0, "y": 200, "properties": {"segment": "cloud_dmz", "subnet": "172.16.0.0/24", "image": "generic-switch"}}, {"id": 8, "label": "DMZ-Web-Server", "type": "VPCS", "x": 0, "y": 300, "properties": {"ip": "172.16.0.10/24", "gateway": "172.16.0.1", "role": "dmz_web_service_target", "traffic_origin": []}}, {"id": 9, "label": "Internet-Attacker", "type": "VPCS", "x": -500, "y": -350, "properties": {"ip": "203.0.113.10/24", "gateway": "203.0.113.1", "role": "outside_attacker_internet", "traffic_origin": ["DoS", "Probe", "R2L"]}}, {"id": 10, "label": "ZTA-Policy-Enforcement-Point", "type": "VPCS", "x": 0, "y": 50, "properties": {"ip": "0.0.0.0", "bind": "0.0.0.0:5000", "role": "zta_policy_enforcement_point", "description": "Host running the Flask risk-scoring API (src/api.py). Traffic routed inline through this host so the Zeek tap can observe it.", "api_endpoint": "http://0.0.0.0:5000/predict", "audit_log": "data/audit.jsonl"}}, {"id": 11, "label": "Zeek-SPAN-Tap", "type": "switch", "x": 120, "y": 50, "properties": {"role": "zeek_capture_sensor", "capture_mode": "SPAN / mirror port on the link into the ZTA enforcement point", "description": "Mirrors the link into the ZTA enforcement point. Zeek (Docker zeek/zeek:latest where available) parses the mirrored pcaps into conn.logs consumed by src/zeek_capture.parse_conn_log.", "outputs": "data/gns3/conn_logs/*_conn.log"}}], "links": [{"id": 1, "source": {"node_id": 1, "port": "Gi0/0"}, "target": {"node_id": 2, "port": 0}, "label": "Core<->HQ", "span_tap": false}, {"id": 2, "source": {"node_id": 2, "port": 1}, "target": {"node_id": 3, "port": 0}, "label": "SW-HQ<->HQ-Workstation", "span_tap": false}, {"id": 3, "source": {"node_id": 1, "port": "Gi0/1"}, "target": {"node_id": 4, "port": 0}, "label": "Core<->Branch", "span_tap": false}, {"id": 4, "source": {"node_id": 4, "port": 1}, "target": {"node_id": 5, "port": 0}, "label": "SW-Branch<->Branch-Hybrid-Worker", "span_tap": false}, {"id": 5, "source": {"node_id": 4, "port": 2}, "target": {"node_id": 6, "port": 0}, "label": "SW-Branch<->Branch-Compromised-Host", "span_tap": false}, {"id": 6, "source": {"node_id": 1, "port": "Gi0/2"}, "target": {"node_id": 7, "port": 0}, "label": "Core<->DMZ", "span_tap": false}, {"id": 7, "source": {"node_id": 7, "port": 1}, "target": {"node_id": 8, "port": 0}, "label": "SW-DMZ<->DMZ-Web-Server", "span_tap": false}, {"id": 8, "source": {"node_id": 1, "port": "Gi0/3"}, "target": {"node_id": 9, "port": 0}, "label": "Core<->Internet-Attacker", "span_tap": false}, {"id": 9, "source": {"node_id": 1, "port": "Gi0/2"}, "target": {"node_id": 10, "port": 0}, "label": "Core<->ZTA-PEP (inline enforcement path)", "span_tap": false, "description": "Traffic to/from the DMZ/cloud and the enforcement point flows inline here."}, {"id": 10, "source": {"node_id": 9, "port": 0}, "target": {"node_id": 10, "port": 0}, "label": "Internet-Attacker<->ZTA-PEP", "span_tap": false}, {"id": 11, "source": {"node_id": 10, "port": 0}, "target": {"node_id": 11, "port": 0}, "label": "ZTA-PEP<->Zeek-SPAN-Tap (Zeek capture / mirror link into the enforcement point)", "span_tap": true, "capture": "zeek", "description": "SPAN/mirror of the link into the ZTA enforcement point. Zeek reads this tap and emits conn.logs to data/gns3/conn_logs/."}], "capture_taps": [{"link_id": 11, "sensor": "Zeek-SPAN-Tap", "placement": "mirror of the link into the ZTA-Policy-Enforcement-Point", "output_format": "conn.log (TSV with #fields header matching data/logs/conn.log)", "consumer": "src/zeek_capture.parse_conn_log -> src/api.py /predict"}]}